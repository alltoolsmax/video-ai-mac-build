{
  "_note": "Selector cho Muse (muse.ai — trợ lý AI của Meta, đọc từ trang thật 11/2026). Sửa khi web đổi giao diện.",
  "url": "https://muse.ai/",
  "captcha_markers": [
    "iframe[src*='challenges.cloudflare']",
    "iframe[src*='recaptcha']",
    "iframe[src*='hcaptcha']",
    "text=/verify (you are|that you're) (a )?human/i",
    "text=/security check/i"
  ],
  "logged_out_markers": [
    "input[placeholder*='Mobile number or email' i]"
  ],
  "blocked_markers": [
    "text=/(violat|policy|not allowed|can't generate|couldn't generate|unable to generate)/i",
    "text=/(vi phạm|chính sách|không thể tạo)/i"
  ],
  "quota_markers": [
    "text=/(out of credits|not enough credits|limit reached|reached your limit|upgrade to continue)/i",
    "text=/(hết (lượt|credit|tín dụng)|đạt giới hạn)/i"
  ],
  "prompt": [
    "textarea[placeholder='Message']",
    "textarea[aria-label='Message']",
    "textarea"
  ],
  "submit": [
    "button[aria-label='Send']",
    "button[aria-label*='Send' i]"
  ],
  "attach_button": [
    "button[aria-label='Attach file']"
  ],
  "file_input": [
    "input[type='file']"
  ],
  "result_media": [
    "[data-testid='hatch-chat-attachment-presentation-video'] video",
    "[data-testid='hatch-chat-attachment-presentation-image'] img"
  ],
  "result_min_px": 256,
  "credits": [],
  "options": {},
  "_version": 2
}