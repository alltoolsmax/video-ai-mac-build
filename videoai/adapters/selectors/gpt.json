{
  "_note": "Selector cho ChatGPT Images (đọc từ chatgpt.com 11/2026). Sửa khi web đổi giao diện. Mỗi khóa là danh sách selector, thử lần lượt.",
  "url": "https://chatgpt.com/images/",
  "captcha_markers": [
    "iframe[src*='challenges.cloudflare']",
    "iframe[src*='recaptcha']",
    "iframe[src*='hcaptcha']",
    "iframe[src*='arkoselabs']",
    "text=/verify (you are|that you're) (a )?human/i",
    "text=/performing security verification/i",
    "text=/xác minh bạn (là|không phải)/i"
  ],
  "logged_out_markers": [
    "[data-testid='login-button']"
  ],
  "blocked_markers": [
    "text=/(violat|policy|not allowed|can't generate|couldn't generate|unable to generate)/i",
    "text=/(vi phạm|chính sách|không thể tạo)/i"
  ],
  "quota_markers": [
    "text=/(out of credits|not enough credits|limit reached|reached your limit|upgrade to continue)/i",
    "text=/(hết (lượt|credit|tín dụng)|đạt giới hạn)/i"
  ],
  "prompt": [
    "div.ProseMirror[contenteditable='true']",
    "#prompt-textarea",
    "textarea"
  ],
  "submit": [
    "button[data-testid='send-button']",
    "button[aria-label='Send']",
    "button[aria-label*='Send' i]"
  ],
  "attach_button": [
    "button[aria-label*='upload' i]",
    "button[aria-label*='image' i]",
    "button[aria-label*='attach' i]",
    "button:has-text('Add')"
  ],
  "file_input": [
    "input[type='file']"
  ],
  "result_media": [
    "img[alt^='Generated image']"
  ],
  "result_min_px": 256,
  "credits": [],
  "options": {},
  "_version": 2
}