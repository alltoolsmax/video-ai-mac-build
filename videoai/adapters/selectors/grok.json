{
  "_note": "Selector cho Grok Imagine (bản thử nghiệm 11/2026). Sửa khi web đổi giao diện; khi lỗi, Log ghi 'Grok chẩn đoán' để chỉnh.",
  "url": "https://grok.com/imagine",
  "captcha_markers": [
    "iframe[src*='challenges.cloudflare']",
    "iframe[src*='recaptcha']",
    "iframe[src*='hcaptcha']",
    "text=/verify (you are|that you're) (a )?human/i",
    "text=/performing security verification/i",
    "text=/xác minh bạn (là|không phải)/i"
  ],
  "logged_out_markers": [
    "a[href*='/sign-in']",
    "a[href*='accounts.x.ai']",
    "button:has-text('Sign in')",
    "button:has-text('Sign up')",
    "button:has-text('Đăng nhập')"
  ],
  "blocked_markers": [
    "text=/(violat|policy|not allowed|can't generate|couldn't generate|unable to generate)/i",
    "text=/(vi phạm|chính sách|không thể tạo)/i"
  ],
  "quota_markers": [
    "text=/(out of credits|not enough credits|limit reached|reached your limit|upgrade to continue)/i",
    "text=/(hết (lượt|credit|tín dụng)|đạt giới hạn)/i"
  ],
  "prompt": [
    "textarea:visible",
    "div[contenteditable='true']:visible",
    "[role='textbox']:visible"
  ],
  "submit": [
    "button[type='submit']",
    "button[aria-label='Submit']",
    "button[aria-label*='Submit' i]",
    "button[aria-label*='Generate' i]",
    "button[aria-label*='Send' i]",
    "button:has-text('Create')",
    "button:has-text('Generate')",
    "button:has-text('Tạo')"
  ],
  "attach_button": [
    "button[aria-label*='upload' i]",
    "button[aria-label*='image' i]",
    "button[aria-label*='attach' i]",
    "button:has-text('Add')"
  ],
  "file_input": [
    "input[type='file']"
  ],
  "result_media": [
    "video",
    "img[src*='imagine']",
    "main img"
  ],
  "result_min_px": 256,
  "credits": [],
  "options": {},
  "_version": 2,
  "imagine_min_px": 400
}