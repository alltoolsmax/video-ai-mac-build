{
  "_note": "Google Flow dùng adapter riêng (adapters/flow.py). File này chỉ còn dùng cho dấu hiệu captcha/đăng xuất.",
  "url": "https://flow.google.com/",
  "captcha_markers": [
    "iframe[src*='recaptcha']",
    "iframe[src*='hcaptcha']",
    "iframe[src*='challenges.cloudflare']",
    "text=/verify (you are|that you're) (a )?human/i",
    "text=/xác minh bạn (là|không phải)/i"
  ],
  "logged_out_markers": [
    "text=/^(sign in|log in|đăng nhập)$/i",
    "a[href*='accounts.google.com/ServiceLogin']",
    "button:has-text('Sign in')",
    "button:has-text('Log in')"
  ],
  "blocked_markers": [
    "text=/(violat|policy|not allowed|can't generate|couldn't generate|unable to generate)/i",
    "text=/(vi phạm|chính sách|không thể tạo)/i"
  ],
  "quota_markers": [
    "text=/(out of credits|not enough credits|limit reached|reached your limit|upgrade to continue)/i",
    "text=/(hết (lượt|credit|tín dụng)|đạt giới hạn)/i"
  ],
  "prompt": [
    "div.ProseMirror[contenteditable='true']"
  ],
  "submit": [
    "button.generate-icon-button",
    "button[type='submit']"
  ],
  "attach_button": [
    "button[aria-label*='upload' i]",
    "button[aria-label*='image' i]",
    "button[aria-label*='attach' i]",
    "button:has-text('Add')"
  ],
  "file_input": [
    "input[type='file']"
  ],
  "result_media": [
    "video",
    "img[src*='googleusercontent']",
    "img[src^='blob:']",
    "img[src^='data:image']"
  ],
  "result_min_px": 256,
  "credits": [
    "text=/\\d+\\s*(AI )?credits/i"
  ],
  "options": {
    "_example": {
      "ratio": {
        "9:16 Dọc": [
          "button[aria-label*='aspect' i]",
          "text=/^9:16/"
        ]
      }
    }
  }
}