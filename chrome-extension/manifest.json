{
  "manifest_version": 3,
  "name": "Video AI · Mr. Huỳnh — Trợ lý",
  "version": "1.0.0",
  "description": "Theo dõi và điều khiển Video AI - Mr. Huỳnh: trạng thái kết nối, đăng nhập Google Flow, số tác vụ, tạm dừng/tiếp tục và nhắc xác minh reCAPTCHA.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Video AI · Mr. Huỳnh",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://flow.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
