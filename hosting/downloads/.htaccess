# mrhuynh.net/downloads/ – khách tải video_ai_mrhuynh_win.zip / video_ai_mrhuynh_mac.zip;
# tự cập nhật dùng video_ai_mrhuynh_win.exe / video_ai_mrhuynh_mac.dmg (tên cố định)
Options -Indexes
DirectoryIndex index.html

# luôn dùng HTTPS (tải exe qua http bị trình duyệt chặn). Không lặp khi hosting nằm sau Cloudflare.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP:CF-Visitor} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

AddType application/octet-stream .exe
AddType application/x-apple-diskimage .dmg
AddType application/json .json
AddType application/zip .zip

# tên tệp không đổi giữa các phiên bản → cấm lưu đệm để người tải luôn nhận bản mới nhất
<FilesMatch "\.(exe|dmg|zip|html|txt|json)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>
<FilesMatch "\.exe$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment; filename=video_ai_mrhuynh_win.exe"
    Header set X-Content-Type-Options "nosniff"
  </IfModule>
</FilesMatch>
<FilesMatch "\.dmg$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment; filename=video_ai_mrhuynh_mac.dmg"
    Header set X-Content-Type-Options "nosniff"
  </IfModule>
</FilesMatch>
<FilesMatch "^video_ai_mrhuynh_win\.zip$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment; filename=video_ai_mrhuynh_win.zip"
  </IfModule>
</FilesMatch>
<FilesMatch "^video_ai_mrhuynh_mac\.zip$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment; filename=video_ai_mrhuynh_mac.zip"
  </IfModule>
</FilesMatch>
